                  reflectance="0" specular="0" shininess="0"/>
    </asset>
    <worldbody>
        <geom name="floor" type="hfield" hfield="rough_terrain"
              pos="8.0 0 -0.132412351" material="terrain_material" condim="3"/>
    </worldbody>
</mujoco>
